{
  "name": "anvil",
  "version": "0.1.0",
  "private": true,
  "description": "ANVIL: an algorithmic MIDI composition instrument for themes, variations and accompaniment",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/anvil/",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run build:pages && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/tiny5": "^5.3.0"
  }
}
